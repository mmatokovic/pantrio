<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="pantrio">
        <createTable tableName="item_instance">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="storage_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_date" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="pantrio">
        <addForeignKeyConstraint
            baseTableName="item_instance"
            baseColumnNames="item_id"
            constraintName="fk_item_instance_item"
            referencedTableName="items"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="3" author="pantrio">
        <addForeignKeyConstraint
            baseTableName="item_instance"
            baseColumnNames="storage_id"
            constraintName="fk_item_instance_storage"
            referencedTableName="storage"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="4" author="pantrio">
        <addUniqueConstraint
            tableName="item_instance"
            columnNames="storage_id, item_id"
            constraintName="uk_item_instance_storage_item"/>
    </changeSet>

    <changeSet id="5" author="pantrio">
        <createIndex tableName="item_instance" indexName="idx_item_instance_storage">
            <column name="storage_id"/>
        </createIndex>
    </changeSet>

    <!-- Oracle does not index foreign key columns; uk_item_instance_storage_item only covers storage_id first -->
    <changeSet id="6" author="pantrio">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="item_instance" columnNames="item_id"/>
            </not>
        </preConditions>
        <createIndex tableName="item_instance" indexName="idx_item_instance_item">
            <column name="item_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="7" author="pantrio">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="item_instance" indexName="idx_item_instance_storage"/>
        </preConditions>
        <dropIndex tableName="item_instance" indexName="idx_item_instance_storage"/>
        <rollback>
            <createIndex tableName="item_instance" indexName="idx_item_instance_storage">
                <column name="storage_id"/>
            </createIndex>
        </rollback>
    </changeSet>
</databaseChangeLog>
