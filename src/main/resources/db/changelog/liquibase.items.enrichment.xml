<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="pantrio">
        <addColumn tableName="items">
            <column name="enriched_at" type="TIMESTAMP"/>
        </addColumn>
        <update tableName="items">
            <column name="enriched_at" valueComputed="COALESCE(updated_at, created_at)"/>
            <where>picture_url IS NOT NULL</where>
        </update>
    </changeSet>
</databaseChangeLog>
