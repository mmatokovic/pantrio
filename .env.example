LOG_PATH=logs
SPRING_PROFILES_ACTIVE=local

# Spring Boot app
PANTRIO_DB_URL=jdbc:oracle:thin:@host.docker.internal:1521/XEPDB1
PANTRIO_DB_USER=PANTRIO
PANTRIO_DB_PASS="oraclepwd123"
